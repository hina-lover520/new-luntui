--- before/project\tests\test_ring_v31_exit.c
+++ after/project\tests\test_ring_v31_exit.c
@@ -0,0 +1,173 @@
+/* v31 exit guards only. Prepared vision history is not a field-lap claim.
+ * The paired runtime portion uses integrated gyro and counts event beeps.
+ * Build with ring_runtime.c and ring_link.c; ring.c is included here. */
+#include "../code/ring.c"
+#include "ring_runtime.h"
+#include "ring_link.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "FAIL v31 exit:%d %s side%d ph%d lap%.3f src%u\n", __LINE__, #c, test_side, ring_result.phase, ring_result.lap_deg, ring_result.path_source); exit(1); } } while (0)
+static int test_side;
+static uint8_t test_pixels[RING_H][RING_W];
+static ring_motion_t test_motion;
+static uint32_t test_sequence, test_epoch;
+static unsigned test_beeps;
+static float test_speed, test_turn, test_revs;
+
+/* Ordinary road bends its image bearing away from the old entry turn.
+ * Both boundaries and the lane width remain visible over the whole image. */
+static void test_ordinary(int side)
+{
+    int x,y;
+    memset(test_pixels,0,sizeof(test_pixels));
+    for (y=0;y<RING_H;++y) {
+        int l=64+(117-y)/6;
+        for (x=l;x<l+60;++x)
+            test_pixels[y][side<0?x:RING_W-1-x]=255;
+    }
+}
+static void test_prepare(int side,float degrees,int shared)
+{
+    test_side=side;ring_init();test_ordinary(side);
+    test_motion=(ring_motion_t){100,side*degrees,2,1};
+    ring_result.phase=RING_CIRCLE;
+    ring_result.ring_side=(int8_t)side;ring_result.route=(int8_t)-side;
+    ring_result.committed=ring_result.left_entry=ring_result.lap_valid=1;
+    ring_result.lap_origin_yaw=0;
+    ring_result.approach_stage=(uint8_t)(shared?RING_TANGENT_SHARED:RING_TANGENT_LEFT);
+    ring_result.detected_events=1;ring_since=phase_since=100;
+    timed_started=1;tangent_lap_revs=1;
+    ring_observe_maneuver_feedback(3,(int16_t)(degrees*10));
+    CHECK((side==-1 && ring_result.route==1) || (side==1 && ring_result.route==-1));
+}
+static void test_vision_step(void)
+{
+    test_motion.now_ms+=20;test_motion.wheel_revs+=.02f;
+    ring_observe_frame_interval(20);ring_observe_track(1);
+    ring_update((const uint8_t(*)[RING_W])test_pixels,&test_motion);
+}
+static void test_vision_reject(int side,int kind)
+{
+    int i;
+    test_prepare(side,kind==0?180.f:kind==1?270.f:360.1f,1);
+    if (kind==2) {
+        /* A latched prior lap cannot authorize the opposite heading. */
+        tangent_lap(&test_motion);CHECK(lap_completed);
+        test_motion.yaw_deg=side*540.f;
+    }
+    for (i=0;i<35;++i) {
+        test_vision_step();
+        CHECK(!ring_result.exited_events);
+        CHECK(ring_result.phase!=RING_EXIT && ring_result.phase!=RING_RECOVER);
+    }
+}
+static void test_vision_exit(int side,int shared)
+{
+    int i,y;
+    test_prepare(side,360.1f,shared);
+    for (i=0;i<50 && !ring_result.exited_events;++i) {
+        test_vision_step();
+        if (ring_owns_path()) {
+            CHECK(ring_result.path_valid && ring_result.path_source==4);
+            CHECK(ring_result.steer_error*side<0);
+            /* A ring-edge normal must not replace this current through
+             * corridor while ordinary-road exit evidence accumulates. */
+            for (y=24;y<=117;++y) {
+                int centre=94+(117-y)/6;
+                if (side>0) centre=RING_W-1-centre;
+                CHECK(ring_result.mid[y]>=0);
+                CHECK(abs(ring_result.mid[y]-centre)<=3);
+                CHECK(test_pixels[y][ring_result.mid[y]]!=0);
+            }
+        }
+        if (i<11) CHECK(!ring_result.exited_events);
+    }
+    CHECK(ring_result.exited_events==1 && !ring_owns_path());
+    CHECK(!ring_result.stop && !ring_result.timed_entry && ring_speed_limit()==-1);
+    CHECK(ring_blend_error(-41)==-41 && ring_blend_error(0)==0 && ring_blend_error(23)==23);
+}
+static void test_tick(int raw,unsigned count,int standing)
+{
+    while (count--) if (ring_runtime_tick((int16_t)raw,(uint8_t)standing)==1) ++test_beeps;
+}
+static void test_apply(void)
+{
+    test_speed=100;test_turn=-33;
+    ring_runtime_observe_motion(100,0,0,0,0);
+    ring_runtime_apply(&test_speed,&test_turn,test_revs,1);
+}
+static void test_command(int side,int phase,unsigned exited)
+{
+    ring_packet_t p={{0}};
+    int owned=phase>=RING_APPROACH && phase<=RING_RECOVER;
+    p.word[RL_MAGIC]=RING_LINK_MAGIC;p.word[RL_EPOCH]=(int32_t)test_epoch;
+    p.word[RC_PHASE]=ring_command_versioned_phase(phase,0,RING_PAIR_VERSION);
+    p.word[RC_CAP]=ring_command_cap_turn(owned?(phase==RING_APPROACH?100:90):-1,360);
+    p.word[RC_DETECTED]=1;p.word[RC_EXITED]=(int32_t)exited;
+    p.word[RC_FAULT]=ring_command_diagnostics(0,1,0,0,1,0,1,0,80,-side);
+    if (phase==RING_APPROACH) p.word[RC_FAULT]=(int32_t)((uint32_t)p.word[RC_FAULT]|RING_COMMAND_FORCE_ENTRY);
+    if (owned) p.word[RC_FAULT]=(int32_t)((uint32_t)p.word[RC_FAULT]|RING_COMMAND_TIMED_ENTRY);
+    ring_link_write(ring_command_mailbox,&p,&test_sequence);test_apply();
+}
+static void test_runtime_boot(int side)
+{
+    unsigned i;
+    test_side=side;test_sequence=test_beeps=0;test_revs=0;
+    memset(ring_command_mailbox,0,RING_LINK_WORDS*sizeof(int32_t));
+    memset(ring_motion_mailbox,0,RING_LINK_WORDS*sizeof(int32_t));
+    ring_runtime_init(.1f);ring_runtime_set_operator(0,0);
+    test_tick(0,2200,0);ring_runtime_set_operator(1,0);
+    test_tick(0,1,1);test_apply();test_epoch=ring_runtime_diagnostics()->command_epoch;
+    test_command(side,RING_APPROACH,0);
+    for (i=0;i<RING_MANEUVER_DELAY_MS/20u+2u;++i) {
+        test_tick(0,20,1);test_revs+=.03f;test_command(side,RING_APPROACH,0);
+        if (ring_runtime_diagnostics()->maneuver_stage==2) break;
+    }
+    CHECK(ring_runtime_diagnostics()->maneuver_stage==2 && test_beeps==1);
+}
+static void test_runtime_advance(int side,unsigned ms)
+{
+    while (ms) {
+        unsigned n=ms>20u?20u:ms;
+        test_tick(side*1000,n,1);test_revs+=.0015f*n;
+        test_command(side,RING_ENTER,0);ms-=n;
+    }
+}
+static void test_runtime_reject(int side,int kind)
+{
+    uint32_t accepted;
+    const ring_runtime_diagnostics_t *d;
+    test_runtime_boot(side);
+    test_runtime_advance(side,kind==0?1800u:kind==1?2700u:3601u);
+    if (kind==2) test_runtime_advance(side,1799u);
+    d=ring_runtime_diagnostics();CHECK(d->maneuver_stage==3 && d->active);
+    accepted=d->command_sequence;
+    test_command(side,RING_EXIT,0);
+    CHECK(d->command_sequence==accepted && d->phase==RING_ENTER);
+    test_command(side,RING_COOLDOWN,1);
+    CHECK(d->command_sequence==accepted && d->active && !d->exited);
+    test_tick(0,100,1);
+    CHECK(test_beeps==1); /* Recognition only; rejected exit emits no beep. */
+}
+static void test_runtime_exit(int side)
+{
+    test_runtime_boot(side);test_runtime_advance(side,3601u);
+    CHECK(ring_runtime_diagnostics()->maneuver_stage==3);
+    test_command(side,RING_COOLDOWN,1);
+    CHECK(!ring_runtime_diagnostics()->active && ring_runtime_diagnostics()->exited==1);
+    CHECK(test_turn==-33);
+    test_tick(0,100,1);CHECK(test_beeps==2);
+}
+int main(void)
+{
+    int side,kind,shared;
+    CHECK(RING_EXIT_MIN_DEG==360.f && RING_LAP_EXIT_HEADING_TOL==15.f);
+    for (side=-1;side<=1;side+=2) {
+        for (kind=0;kind<3;++kind) {test_vision_reject(side,kind);test_runtime_reject(side,kind);}
+        for (shared=0;shared<=1;++shared) test_vision_exit(side,shared);
+        test_runtime_exit(side);
+    }
+    puts("PASS: v31 both sides,180/270 and past360-opposite heading reject exit/beep; full360 straight exit keeps current through corridor and restores ordinary steering;360/15deg guards retained");
+    return 0;
+}
--- before/project\tests\test_ring_v31_motion.c
+++ after/project\tests\test_ring_v31_motion.c
@@ -0,0 +1,81 @@
+/* Runtime-level entry regression. No motor or track dynamics claim. */
+#include "ring_runtime.h"
+#include "ring_link.h"
+#include "ring.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#define CHECK(c) do{if(!(c)){fprintf(stderr,"FAIL v31 motion:%d %s f%.2f t%.2f man%u\n",__LINE__,#c,speed,turn,ring_runtime_diagnostics()->maneuver_stage);exit(1);}}while(0)
+static float speed,turn,measured;static uint32_t seq,epoch;
+static void tick(int raw,unsigned n,int standing)
+{while(n--)(void)ring_runtime_tick((int16_t)raw,(uint8_t)standing);}
+static void apply(void)
+{speed=100;turn=17;ring_runtime_observe_motion(measured,0,0,0,0);
+ ring_runtime_apply(&speed,&turn,1,3);}
+static void command(int side,int phase)
+{
+ ring_packet_t p={{0}};p.word[RL_MAGIC]=RING_LINK_MAGIC;p.word[RL_EPOCH]=(int32_t)epoch;
+ p.word[RC_PHASE]=ring_command_versioned_phase(phase,0,RING_PAIR_VERSION);
+ p.word[RC_CAP]=ring_command_cap_turn(phase==RING_APPROACH?100:90,0);p.word[RC_DETECTED]=1;
+ p.word[RC_FAULT]=ring_command_diagnostics(0,1,0,0,1,0,1,0,80,-side);
+ p.word[RC_FAULT]=(int32_t)((uint32_t)p.word[RC_FAULT]|RING_COMMAND_TIMED_ENTRY);
+ if(phase==RING_APPROACH)p.word[RC_FAULT]=(int32_t)((uint32_t)p.word[RC_FAULT]|RING_COMMAND_FORCE_ENTRY);
+ ring_link_write(ring_command_mailbox,&p,&seq);apply();
+}
+static void boot(void)
+{
+ memset(ring_command_mailbox,0,32);memset(ring_motion_mailbox,0,32);seq=0;
+ ring_runtime_init(.1f);ring_runtime_set_operator(0,0);
+ /* The old one-second window would store this -130dps hand movement.
+  * Stable standby afterward must replace it before RUN freezes the zero. */
+ tick(20,999,0);tick(-1300,1001,0);tick(20,1000,0);
+ measured=100;apply();CHECK(ring_runtime_diagnostics()->yaw_calibrated);
+ CHECK(abs(ring_runtime_diagnostics()->yaw_bias_raw-20)<=1);
+ ring_runtime_set_operator(1,0);tick(20,10,1);apply();
+ epoch=ring_runtime_diagnostics()->command_epoch;
+ CHECK(abs(ring_runtime_diagnostics()->force_rate10)<=1);
+}
+static void motion(int side)
+{
+ unsigned i;const ring_runtime_diagnostics_t *d=ring_runtime_diagnostics();
+ boot();measured=0;command(side,RING_APPROACH);
+ for(i=0;i<40;++i){tick(20,50,1);command(side,RING_APPROACH);}
+ CHECK(d->maneuver_stage==1 && !d->force_active && d->force_reason==2);
+ measured=-20;tick(20,50,1);command(side,RING_APPROACH);
+ CHECK(d->maneuver_stage==1 && !d->force_active);
+ measured=100;tick(20,50,1);command(side,RING_APPROACH);
+ CHECK(d->maneuver_stage==2 && d->force_active && side*turn>0);
+ /* Full authority is preserved when the vehicle actually advances. */
+ tick(20,50,1);command(side,RING_ENTER);
+ CHECK(d->entry_turn_cap10==900 && side*turn>0 && speed>0);
+ measured=5;tick(20,50,1);command(side,RING_ENTER);
+ CHECK(fabsf(turn)<=5.001f && d->entry_turn_cap10==50 && speed>0);
+ measured=0;tick(20,50,1);command(side,RING_ENTER);
+ CHECK(turn==0 && speed>0 && d->force_reason==8);
+ measured=-50;tick(20,50,1);command(side,RING_ENTER);
+ CHECK(turn==0 && speed>0 && d->entry_turn_cap10==0);
+ measured=100;tick(20+side*1000,100,1);command(side,RING_ENTER);
+ CHECK(side*turn>0 && d->maneuver_stage==2);
+ for(i=0;i<7;++i){tick(20+side*1000,100,1);command(side,RING_ENTER);}
+ CHECK(d->maneuver_stage==3 && !d->force_active);
+ CHECK(d->yaw_bias_raw==20); /* a true turn never becomes a new zero */
+ tick(20,350,1);apply();CHECK(turn==17 && speed>0);
+}
+static void invalid_zero(void)
+{
+ unsigned i;const ring_runtime_diagnostics_t *d=ring_runtime_diagnostics();
+ memset(ring_command_mailbox,0,32);memset(ring_motion_mailbox,0,32);seq=0;
+ ring_runtime_init(.1f);ring_runtime_set_operator(0,0);tick(1500,3000,0);
+ ring_runtime_set_operator(1,0);measured=100;tick(20,1,1);apply();
+ epoch=d->command_epoch;CHECK(!d->yaw_calibrated);
+ for(i=0;i<40;++i){tick(20,50,1);command(-1,RING_APPROACH);}
+ CHECK(!d->active && !d->force_active && !d->maneuver_stage && turn==17 && speed==100);
+}
+int main(void)
+{
+ CHECK(RING_ENTRY_MIN_FORWARD_RPM>0 && RING_MANEUVER_TURN_DEG==75.f);
+ motion(-1);motion(1);invalid_zero();
+ puts("PASS: boot hand-motion bias corrected in standby; stationary/reverse cannot arm; full75 authority with forward motion; collapse suppresses axle spin without zero/negative forward request; both sides and uncalibrated isolation");
+ return 0;
+}
--- before/project\tests\test_ring_yaw_bias.c
+++ after/project\tests\test_ring_yaw_bias.c
@@ -0,0 +1,162 @@
+#include "ring_yaw_bias.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(c) do { if (!(c)) { \
+    fprintf(stderr, "FAIL yaw bias:%d %s\n", __LINE__, #c); exit(1); \
+} } while (0)
+#define NEAR(a,b) (fabsf((a) - (b)) < 0.01f)
+
+static void feed(ring_yaw_bias_t *s, uint32_t first, uint32_t last,
+    int16_t raw, int standing, int run)
+{
+    uint32_t now;
+    for (now = first; now <= last; ++now)
+        ring_yaw_bias_update(s, raw, now, standing, run);
+}
+
+static void startup_and_offset(void)
+{
+    ring_yaw_bias_t s;
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 999, 73, 0, 0);
+    CHECK(!s.ready && !s.samples && s.window_state == RING_YAW_BIAS_STARTUP);
+    feed(&s, 1000, 1249, 73, 0, 0);
+    CHECK(!s.ready);
+    feed(&s, 1250, 1499, 73, 0, 0);
+    CHECK(!s.ready);
+    feed(&s, 1500, 1500, 73, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, 73.0f));
+    CHECK(NEAR(ring_yaw_bias_rate(&s, 73), 0.0f));
+    CHECK(s.accepted == 1 && s.updated_ms == 1500 && s.raw == 73);
+}
+
+static void implausible_constant_rotation(void)
+{
+    ring_yaw_bias_t s;
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 2000, 1000, 0, 1);
+    CHECK(!s.ready && s.accepted == 0);
+    CHECK(s.window_state == RING_YAW_BIAS_UNSTABLE);
+    feed(&s, 2001, 2500, 25, 0, 1);
+    CHECK(s.ready && NEAR(s.bias, 25.0f));
+}
+
+static void noisy_start_then_still(void)
+{
+    ring_yaw_bias_t s;
+    uint32_t now;
+    ring_yaw_bias_init(&s, 0.1f);
+    for (now = 0; now <= 2000; ++now)
+        ring_yaw_bias_update(&s, (int16_t)(now % 2 ? -100 : 100),
+            now, 0, 0);
+    CHECK(!s.ready && s.window_state == RING_YAW_BIAS_UNSTABLE);
+    feed(&s, 2001, 2500, 20, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, 20.0f));
+}
+
+static void changing_means_need_consecutive_windows(void)
+{
+    ring_yaw_bias_t s;
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 1250, 0, 0, 0);
+    CHECK(!s.ready && s.previous_stable);
+    feed(&s, 1251, 1500, 20, 0, 0); /* individually stable, mean differs2dps */
+    CHECK(!s.ready && s.window_state == RING_YAW_BIAS_FIRST_STABLE);
+    feed(&s, 1501, 1750, 20, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, 20.0f));
+}
+
+static void idle_recalibration(void)
+{
+    ring_yaw_bias_t s;
+    uint32_t now;
+    ring_yaw_bias_init(&s, 0.1f);
+    /* Z alone cannot reject a constant turn. Later genuine rest must replace
+     * this estimate before RUN, rather than latch a startup mistake forever. */
+    feed(&s, 0, 2000, 70, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, 70.0f));
+    for (now = 2001; now <= 2500; ++now)
+        ring_yaw_bias_update(&s, (int16_t)(now % 2 ? -100 : 100),
+            now, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, 70.0f));
+    feed(&s, 2501, 3000, -30, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, -30.0f));
+    CHECK(NEAR(ring_yaw_bias_rate(&s, -30), 0.0f));
+}
+
+static void run_and_standing_freeze(void)
+{
+    ring_yaw_bias_t s;
+    unsigned accepted;
+    float heading = 0.0f;
+    uint32_t now;
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 2000, 10, 0, 0);
+    CHECK(s.ready);
+    accepted = s.accepted;
+    feed(&s, 2001, 3000, 400, 0, 1);
+    CHECK(s.window_state == RING_YAW_BIAS_RUN_FROZEN);
+    CHECK(NEAR(s.bias, 10.0f) && s.accepted == accepted);
+    for (now = 3001; now <= 4000; ++now) {
+        ring_yaw_bias_update(&s, 1010, now, 1, 1);
+        heading += ring_yaw_bias_rate(&s, 1010) * 0.001f;
+    }
+    CHECK(NEAR(heading, 100.0f));
+    for (now = 4001; now <= 5000; ++now) {
+        ring_yaw_bias_update(&s, -990, now, 1, 0);
+        heading += ring_yaw_bias_rate(&s, -990) * 0.001f;
+    }
+    CHECK(NEAR(heading, 0.0f));
+    CHECK(NEAR(s.bias, 10.0f) && s.accepted == accepted);
+    CHECK(s.window_state == RING_YAW_BIAS_STANDING_FROZEN);
+}
+
+static void early_run_and_unready_standing(void)
+{
+    ring_yaw_bias_t s;
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 2000, 10, 0, 1); /* preserve existing boot with RUN already set */
+    CHECK(s.ready && NEAR(s.bias, 10.0f));
+    CHECK(s.window_state == RING_YAW_BIAS_RUN_FROZEN);
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 3000, 1010, 1, 1);
+    CHECK(!s.ready && NEAR(ring_yaw_bias_rate(&s, 1010), 0.0f));
+}
+
+static void gaps_duplicates_invalid_and_wrap(void)
+{
+    ring_yaw_bias_t s;
+    uint32_t now, boot = UINT32_MAX - 1200u;
+    ring_yaw_bias_init(&s, 0.1f);
+    feed(&s, 0, 1250, 10, 0, 0);
+    ring_yaw_bias_update(&s, 10, 1300, 0, 0);
+    CHECK(!s.previous_stable && s.samples == 1);
+    ring_yaw_bias_update(&s, 10, 1300, 0, 0);
+    CHECK(s.samples == 1 && !s.ready);
+    s.scale = 0.0f;
+    ring_yaw_bias_update(&s, 10, 1301, 0, 0);
+    CHECK(!s.ready && !s.samples && s.window_state == RING_YAW_BIAS_INVALID_SCALE);
+    CHECK(ring_yaw_bias_rate(&s, 10) == 0.0f);
+    s.scale = NAN;
+    ring_yaw_bias_update(&s, 10, 1302, 0, 0);
+    CHECK(!s.ready && s.window_state == RING_YAW_BIAS_INVALID_SCALE);
+    ring_yaw_bias_init_at(&s, 0.1f, boot);
+    for (now = 0; now <= 1500; ++now)
+        ring_yaw_bias_update(&s, -15, boot + now, 0, 0);
+    CHECK(s.ready && NEAR(s.bias, -15.0f));
+}
