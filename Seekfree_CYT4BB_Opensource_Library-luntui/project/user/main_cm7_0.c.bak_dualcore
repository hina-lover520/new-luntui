#define LED1                    (P19_0)

#define KEY1                    (P20_0)
#define KEY2                    (P20_1)
#define KEY3                    (P20_2)
#define KEY4                    (P20_3)

#define SWITCH1                 (P21_5)
#define SWITCH2                 (P21_6)

uint16 delay_time = 0;
uint8 led_state = 0;

int main(void)
{
    clock_init(SYSTEM_CLOCK_250M); 	// ??????ü????????<??????>
    debug_init();                          // ???????????????
    // ?????д??????? ?????????????????

    mt9v03x_init();
    ipm_init();          /* compute IPM bird-eye homography (calibrate SRC_* in image.c) */
    ips200_init(IPS200_TYPE_SPI);  /* SPI serial 2in IPS200 (official demo uses SPI); use PARALLEL8 only for 8-bit parallel board */
    ips200_set_dir(IPS200_PORTAIT);  /* portrait 240x320 */
    
    
    // ?????д??????? ?????????????????
    while(true)
    {
        // ?????д????????е????

        if(mt9v03x_finish_flag)
        {
            ipm_warp(mt9v03x_image, ipm_image);   /* inverse perspective -> bird-eye */
            find_amax(ipm_image);
            binarize(ipm_image);
            find_LR(mt9v03x_image_BandW, max);
            arrive_cross();   // 十字直行补线
            ips200_show_gray_image (0, 0, ipm_image[0], IPM_W, IPM_H, 240, 160, 0);
            ips200_show_gray_image (0, 160, mt9v03x_image[0], MT9V03X_W, MT9V03X_H, 240, 160, 0);   /* raw camera, bottom half */
            ipm_draw_calibration_points();   /* overlay 4 IPM corners on raw image */
            show_track_line();//??????
        }
        
        // ?????д????????е????
    }
}

