        Set_project();
        find_amax(mt9v03x_image);
        binarize();
        find_LR(mt9v03x_image_BandW, max);
        detect_cross();
        cross_makeup();
        tft180_show_gray_image (0, 0, mt9v03x_image_project[0], MT9V03X_W, MT9V03X_H, 128, 80,0);
        show_track_line();//��ʾͼ��
