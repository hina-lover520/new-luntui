void Set_project(void)
{
    for (uint8 i = 0; i < MT9V03X_H; i++)            // rows 0..119
    {
        for (uint8 j = 0; j < MT9V03X_W; j++)        // cols 0..187
        {
            mt9v03x_image_project[i][j] = mt9v03x_image[i][j];
        }
    }

    for (uint8 n = 0; n < MT9V03X_W; n++)            // top & bottom border
    {
        mt9v03x_image_project[0][n] = 0;
        mt9v03x_image_project[MT9V03X_H - 1][n] = 0;
    }

    for (uint8 m = 0; m < MT9V03X_H; m++)            // left & right border
    {
        mt9v03x_image_project[m][0] = 0;
        mt9v03x_image_project[m][MT9V03X_W - 1] = 0;
    }
}

void find_amax(unsigned char imageIn[MT9V03X_H][MT9V03X_W])
{
    uint8 i, j;
    threshold = (uint8)GetOSTU(imageIn);   // Otsu threshold

    for (j = 0; j < MT9V03X_W; j++)
    {
        cnt[j] = 0;
        for (i = 0; i < MT9V03X_H; i++)          // from bottom row upward
        {
            if (imageIn[MT9V03X_H - 1 - i][j] > threshold)
                cnt[j]++;
            else
                break;
        }
    }

    max = 0;
    for (j = 1; j < MT9V03X_W; j++)
    {
        if (cnt[j] > cnt[max])
            max = j;
    }
}

void find_LR(unsigned char imageIn[MT9V03X_H][MT9V03X_W], uint8 get_max)
{
    for (int i = 1; i < MT9V03X_H - 1; i++)
    {
        g_left[i] = 0;
        for (int j = get_max; j >= 0; j--)
        {
            if (imageIn[i][j] == 0)
            {
                g_left[i] = j + 1;
                break;
            }
        }
        g_right[i] = MT9V03X_W - 1;
        for (int j = get_max; j < MT9V03X_W; j++)
        {
            if (imageIn[i][j] == 0)
            {
                g_right[i] = j - 1;
                break;
            }
        }
        /* 环岛单边补线：左边界太靠左边缘(≤15)时，中线用右边界往中间收15像素 */
        /* 左右边界夹取，防止 g_left=188 / g_right=-1 缩放越界触发屏幕断言 */
        if (g_left[i]  < 0)               g_left[i]  = 0;
        if (g_left[i]  > MT9V03X_W - 1)   g_left[i]  = MT9V03X_W - 1;
        if (g_right[i] < 0)               g_right[i] = 0;
        if (g_right[i] > MT9V03X_W - 1)   g_right[i] = MT9V03X_W - 1;

        if (g_left[i] <= 15)                                    /* 左边界丢线 → 用右边界往左收60 */
        {
            g_mid[i] = g_right[i] - 60;
        }
        else if (g_right[i] >= MT9V03X_W - 1 - 15)              /* 右边界丢线 → 用左边界往右收60 */
        {
            g_mid[i] = g_left[i] + 60;
        }
        else
        {
            g_mid[i] = (g_left[i] + g_right[i]) / 2;
        }

        /* 中线边界夹取，防止缩放到屏幕时越界触发断言 */
        if (g_mid[i] < 0)               g_mid[i] = 0;
        if (g_mid[i] > MT9V03X_W - 1)   g_mid[i] = MT9V03X_W - 1;
    }
}

void binarize(unsigned char imageIn[MT9V03X_H][MT9V03X_W])
{
    int i, j;
    for (i = 0; i < MT9V03X_H; i++)
        for (j = 0; j < MT9V03X_W; j++)
            mt9v03x_image_BandW[i][j] = (imageIn[i][j] > threshold) ? 255 : 0;
}

void show_track_line(void)
{
    for (int i = 1; i < MT9V03X_H - 1; i++)
    {
        uint16 sy = (uint16)(i * 160 / MT9V03X_H);
        ips200_draw_point((uint16)(g_left[i] * 240 / MT9V03X_W), sy, RGB565_RED);
        ips200_draw_point((uint16)(g_right[i] * 240 / MT9V03X_W), sy, RGB565_BLUE);
        ips200_draw_point((uint16)(g_mid[i] * 240 / MT9V03X_W), sy, RGB565_GREEN);
    }

    /* 调试：检测到十字时，在十字行画一条洋红色横线，观察补线是否生效 */
    if (g_hight_g >= 0)
    {
        uint16 sy = (uint16)(g_hight_g * 160 / MT9V03X_H);
        ips200_draw_line(0, sy, 239, sy, RGB565_MAGENTA);
    }

    /* debug: row1=max,bottom,top row2=below ref(L,R,hw) row3=filled(L,R,M) */
    if (g_hight_g >= 1 && g_hight_g < MT9V03X_H - 1)
    {
        int16_t below = g_hight_g + 1;
        if (below > MT9V03X_H - 2) below = g_hight_g;

        ips200_show_int(0, 272, g_mid_col, 3);                  /* 新中线列(偏中心白点较多) */
        ips200_show_int(40, 272, g_hight_g, 3);           /* 下沿 */
        ips200_show_int(80, 272, g_cross_top_g, 3);       /* 上沿 */

        ips200_show_int(0, 288, g_left[below], 3);       /* 参考左 */
        ips200_show_int(40, 288, g_right[below], 3);     /* 参考右 */
        ips200_show_int(80, 288, (g_right[below] - g_left[below]) / 2, 3); /* 半宽 */

        ips200_show_int(0, 304, g_left[g_hight_g], 3);   /* 补后左 */
        ips200_show_int(40, 304, g_right[g_hight_g], 3); /* 补后右 */
        ips200_show_int(80, 304, g_mid[g_hight_g], 3);   /* 补后中(=新中线列) */
    }
}

/*****************************************************************************
 * arrive_cross(): cross-road straight-line completion.
 * 8-neighborhood cross detection: a cross junction pixel is a white pixel
 * whose 4 cardinal neighbors (up/down/left/right) are all white, i.e. the
 * vertical track meets the horizontal cross arm. The centroid of all junction
 * pixels gives the true vertical-track center column; we then fill the cross
 * band with a straight vertical lane of the normal track width.
 *****************************************************************************/
void arrive_cross(void)
{
    int16_t cross_top    = -1;               /* cross band: far (top) row   */
    int16_t cross_bottom = -1;               /* cross band: near (bottom) row */

    g_hight_g      = -1;
    g_cross_top_g  = -1;
    g_left_g       = -1;
    g_right_g      = -1;
    g_mid_col      = 0;

    /* 1) scan rows top->bottom, find the wide rows that form the cross band */
    for (int i = 1; i < MT9V03X_H - 1; i++)
    {
        if (g_right[i] - g_left[i] >= CROSS_WIDE_MIN)
        {
            if (cross_top < 0) cross_top = i;
            cross_bottom = i;
        }
    }

    if (cross_bottom < 0)
        return;                              /* no cross */

    /* 2) 8-neighborhood: locate the cross junction, centroid = center column */
    int sx = 0;
    int n  = 0;

    for (int i = cross_top; i <= cross_bottom; i++)
    {
        for (int j = 2; j < MT9V03X_W - 2; j++)
        {
            if (mt9v03x_image_BandW[i][j] == 0)
                continue;                    /* not white */

            if (mt9v03x_image_BandW[i-1][j] != 0 &&   /* up    */
                mt9v03x_image_BandW[i+1][j] != 0 &&   /* down  */
                mt9v03x_image_BandW[i][j-1] != 0 &&   /* left  */
                mt9v03x_image_BandW[i][j+1] != 0)     /* right */
            {
                sx += j;
                n++;
            }
        }
    }

    /* reference: the normal row just below the cross band -> half width */
    int16_t below = cross_bottom + 1;
    if (below > MT9V03X_H - 2) below = cross_bottom;
    int16_t hw = (g_right[below] - g_left[below]) / 2;

    int16_t mid_col;
    if (n >= 3)
    {
        mid_col = (int16_t)(sx / n);         /* true vertical-track center */
    }
    else
    {
        mid_col = (g_left[below] + g_right[below]) / 2;   /* fallback */
    }

    g_hight_g     = cross_bottom;
    g_cross_top_g = cross_top;
    g_mid_col     = (uint8)mid_col;
    g_left_g      = mid_col - hw;
    g_right_g     = mid_col + hw;

    /* 3) line completion: straight vertical lane through the cross band */
    for (int i = cross_top; i <= cross_bottom; i++)
    {
        g_mid[i]   = mid_col;
        g_left[i]  = mid_col - hw;
        g_right[i] = mid_col + hw;

        if (g_left[i]  < 0)               g_left[i]  = 0;
        if (g_left[i]  > MT9V03X_W - 1)   g_left[i]  = MT9V03X_W - 1;
        if (g_right[i] < 0)               g_right[i] = 0;
        if (g_right[i] > MT9V03X_W - 1)   g_right[i] = MT9V03X_W - 1;
    }
}

