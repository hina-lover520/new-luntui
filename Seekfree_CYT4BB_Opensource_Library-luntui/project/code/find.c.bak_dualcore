*************************************************************************/
void eye_show (void)//??????
{
  for(int i = 1 ;i<MT9V03X_H-1;i++)
  {
      mt9v03x_image_BandW[i][sumlie] = 1;
  }
  for(int i = 1 ;i<MT9V03X_W-1;i++)
  {
      mt9v03x_image_BandW[sumhang][i] = 1;
  }
    return;
}

