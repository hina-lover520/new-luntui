void Set_project(void)
{
    for (uint8 i = 0; i < MT9V03X_H; i++)            // �� 0~119
    {
        for (uint8 j = 0; j < MT9V03X_W; j++)        // �� 0~187
        {
            mt9v03x_image_project[i][j] = mt9v03x_image[i][j];
        }
    }

    for (uint8 n = 0; n < MT9V03X_W; n++)            // ���±߿�
    {
        mt9v03x_image_project[0][n] = 0;
        mt9v03x_image_project[MT9V03X_H - 1][n] = 0;
    }

    for (uint8 m = 0; m < MT9V03X_H; m++)            // ���ұ߿�
    {
        mt9v03x_image_project[m][0] = 0;
        mt9v03x_image_project[m][MT9V03X_W - 1] = 0;
    }
}
/*****************************************************************************
*��    ע�������
******************************************************************************/
void find_amax(unsigned char imageIn[MT9V03X_H][MT9V03X_W])
{
    uint8 i, j;
    threshold = (uint8)GetOSTU(imageIn);   // otsu threshold

    for (j = 0; j < MT9V03X_W; j++)
    {
        cnt[j] = 0;
        for (i = 0; i < MT9V03X_H; i++)          // from bottom row up
        {
            if (imageIn[MT9V03X_H - 1 - i][j] > threshold)
                cnt[j]++;
            else
                break;
        }
    }

    max = 0;
    for (j = 1; j < MT9V03X_W; j++)
    {
        if (cnt[j] > cnt[max])
            max = j;
    }
}
void find_LR(unsigned char imageIn[MT9V03X_H][MT9V03X_W],uint8 get_max)
{
  for(int i=1;i<MT9V03X_H-1;i++)
  {
    g_left[i]=0;
    for(int j=get_max;j>=0;j--)
    {
      if(imageIn[i][j]==0)
      {
        g_left[i]=j+1;
        break;
      }
    }
    g_right[i]=MT9V03X_W-1;
    for(int j=get_max;j<MT9V03X_W;j++)
    {
      if(imageIn[i][j]==0)
      {
        g_right[i]=j-1;
        break;
      }
    }
    g_mid[i]=(g_left[i]+g_right[i])/2;
  }
}

void binarize(void)
{
  int i, j;
  for (i = 0; i < MT9V03X_H; i++)
    for (j = 0; j < MT9V03X_W; j++)
      mt9v03x_image_BandW[i][j] = (mt9v03x_image[i][j] > threshold) ? 255 : 0;
}

void detect_cross(void)
{
  int i;
  uint8 r_bot, r_top;
  int16 xl_bot, xr_bot, xl_top, xr_top;
  static int16 p_r0 = 0, p_r1 = 0;       /* smoothed bottom/top corner rows */
  static int16 p_xl0 = 0, p_xl1 = 0;     /* left edge bottom/top x */
  static int16 p_xr0 = 0, p_xr1 = 0;     /* right edge bottom/top x */
  static uint8 conf_cnt = 0;
  uint8 found;

  r_bot = 0;
  r_top = 0;

  /* 1. bottom corner: from near to far, both edges lost (into cross arm) */
  for (i = MT9V03X_H - 3; i >= 2; i--)
  {
    if (g_left[i] == 0 && g_right[i] == MT9V03X_W - 1)
    {
      r_bot = i;
      break;
    }
  }

  /* 2. top corner: keep going up, both edges recovered (out of cross arm) */
  if (r_bot != 0)
  {
    for (i = r_bot - 1; i >= 2; i--)
    {
      if (g_left[i] != 0 && g_right[i] != MT9V03X_W - 1)
      {
        r_top = i;
        break;
      }
    }
  }

  /* 3. take corner coords + validity check */
  found = 0;
  if (r_bot != 0 && r_top != 0 && (r_bot - r_top) >= 4)
  {
    xl_bot = g_left[r_bot + 1];       /* last row before lost */
    xr_bot = g_right[r_bot + 1];
    xl_top = g_left[r_top];           /* first recovered row */
    xr_top = g_right[r_top];
    found = 1;
  }

  /* 4. debounce: confirm 2 frames + EMA smoothing */
  if (found)
  {
    if (conf_cnt < 3) conf_cnt++;
  }
  else
  {
    conf_cnt = 0;
    p_r0 = p_r1 = p_xl0 = p_xl1 = p_xr0 = p_xr1 = 0;
  }

  if (found && conf_cnt >= 2)
  {
    if (p_r0 == 0)
    {
      p_r0 = r_bot; p_r1 = r_top;
      p_xl0 = xl_bot; p_xl1 = xl_top;
      p_xr0 = xr_bot; p_xr1 = xr_top;
    }
    else
    {
      p_r0 = (p_r0 * 3 + r_bot) / 4;
      p_r1 = (p_r1 * 3 + r_top) / 4;
      p_xl0 = (p_xl0 * 3 + xl_bot) / 4;
      p_xl1 = (p_xl1 * 3 + xl_top) / 4;
      p_xr0 = (p_xr0 * 3 + xr_bot) / 4;
      p_xr1 = (p_xr1 * 3 + xr_top) / 4;
    }

    corner_row_l[0] = p_r0; corner_x_l[0] = p_xl0;
    corner_row_l[1] = p_r1; corner_x_l[1] = p_xl1;
    corner_row_r[0] = p_r0; corner_x_r[0] = p_xr0;
    corner_row_r[1] = p_r1; corner_x_r[1] = p_xr1;

    cross_flag = 1;
    cross_row = (uint8)((p_r0 + p_r1) / 2);
  }
  else
  {
    cross_flag = 0;
  }
}

void cross_makeup(void)
{
  int i;
  int top, bot;

  if (!cross_flag) return;

  /* ���Ч�յ�ֱ�ӷ��� */
  if (corner_row_l[0] <= corner_row_l[1] || corner_row_r[0] <= corner_row_r[1])
    return;

  /* ��߽ⲹ�ߣ������¹յ���Ϲյ� */
  for (i = corner_row_l[1]; i <= corner_row_l[0]; i++)
  {
    g_left[i] = corner_x_l[1] +
                (corner_x_l[0] - corner_x_l[1]) * (i - corner_row_l[1]) /
                (corner_row_l[0] - corner_row_l[1]);
  }

  /* �ұ߽ⲹ�ߣ������¹յ���Ϲյ� */
  for (i = corner_row_r[1]; i <= corner_row_r[0]; i++)
  {
    g_right[i] = corner_x_r[1] +
                 (corner_x_r[0] - corner_x_r[1]) * (i - corner_row_r[1]) /
                 (corner_row_r[0] - corner_row_r[1]);
  }

  /* ���ߣ�ȡ���Ҳ����ص��� */
  top = corner_row_l[1] > corner_row_r[1] ? corner_row_l[1] : corner_row_r[1];
  bot = corner_row_l[0] < corner_row_r[0] ? corner_row_l[0] : corner_row_r[0];
  for (i = top; i <= bot; i++)
  {
    g_mid[i] = (g_left[i] + g_right[i]) / 2;
  }
}

void show_track_line(void)
{
  for(int i=1;i<MT9V03X_H-1;i++)
  {
    uint16 sy=(uint16)(i*80/MT9V03X_H);
    tft180_draw_point((uint16)(g_left[i]*128/MT9V03X_W), sy, RGB565_RED);
    tft180_draw_point((uint16)(g_right[i]*128/MT9V03X_W), sy, RGB565_BLUE);
    tft180_draw_point((uint16)(g_mid[i]*128/MT9V03X_W), sy, RGB565_GREEN);
  }
  if (cross_flag)
  {
    uint16 cy = (uint16)(cross_row * 80 / MT9V03X_H);
    tft180_draw_line(0, cy, 127, cy, RGB565_YELLOW);

    /* ��ע�ĸ��յ�(��ʮ��) ����֤�յ��� */
    uint16 px, py;
    py = (uint16)(corner_row_l[0] * 80 / MT9V03X_H);
    px = (uint16)(corner_x_l[0] * 128 / MT9V03X_W);
    tft180_draw_line(px - 2, py, px + 2, py, RGB565_WHITE);
    tft180_draw_line(px, py - 2, px, py + 2, RGB565_WHITE);

    py = (uint16)(corner_row_l[1] * 80 / MT9V03X_H);
    px = (uint16)(corner_x_l[1] * 128 / MT9V03X_W);
    tft180_draw_line(px - 2, py, px + 2, py, RGB565_WHITE);
    tft180_draw_line(px, py - 2, px, py + 2, RGB565_WHITE);

    py = (uint16)(corner_row_r[0] * 80 / MT9V03X_H);
    px = (uint16)(corner_x_r[0] * 128 / MT9V03X_W);
    tft180_draw_line(px - 2, py, px + 2, py, RGB565_WHITE);
    tft180_draw_line(px, py - 2, px, py + 2, RGB565_WHITE);

    py = (uint16)(corner_row_r[1] * 80 / MT9V03X_H);
    px = (uint16)(corner_x_r[1] * 128 / MT9V03X_W);
    tft180_draw_line(px - 2, py, px + 2, py, RGB565_WHITE);
    tft180_draw_line(px, py - 2, px, py + 2, RGB565_WHITE);
  }
}


