int16_t OFFSET1;    // �ڶ���
int16_t OFFSET2;    // �����������
int area_map[100]={0};


/*****************************************************************************
*�������ƣ�void SearchNeighbor_4(unsigned char *bitmap, unsigned char *labelmap,uint16 labelIndex,uint16 pixelIndex, Queue *queue)
*����˵��������������������һ�����ӵ㣨pixelIndex����������������������ĸ��������أ����������������ؼ��뵱ǰ��ͨ�򣬲��ö��й������������أ�
*       �����ڶ�ֵͼ�񣨺ڰ�ͼ�����ҳ�������ͨ�İ�ɫ����Ŀ�꣩��������ÿ����ͨ������������λ�ú������ܺ�
*����˵����bitmap:�����ͼ��  labelmap:��Ǿ���
*�������أ���
*�޸�ʱ�䣺2022��4��3��
*��    ע��
******************************************************************************/
uint16_t area;//��¼��ͨ��Ŀ���ͨ�����
int Connected_x[100];// ��¼ÿ����ͨ���x�����ܺ�
int Connected_y[100];// ��¼ÿ����ͨ���y�����ܺ�
short Connected_xmin[100];//��С������
short Connected_ymin[100];//��С������
short Connected_xmax[100];//��������
short Connected_ymax[100];//���������
int32_t Connected_light[100];//�ۼ���ͨ�����������ص�����ֵ�����ڼ���ƽ�����ȡ�

//����������
static int NeighborDirection[4][2] = {{0,1},{1,0},{0,-1},{-1,0}};  //�������ƫ�������ҡ��¡����ϣ�
void SearchNeighbor_4  (unsigned char *bitmap, // �����ֵͼ��0��1��
                        unsigned char *labelmap, // �����Ǿ��󣨼�¼ÿ�����������ĸ���ͨ��
                        uint8 labelIndex,// ��ǰ��ͨ��ı�ǩֵ�����ģ���uint16��Ϊuint8
                        int pixelIndex,  // ��ǰ�������ص�һά����
                        Queue *queue,// ���У����ڹ���������������
                        int x,int y,// ��ǰ�������صĶ�ά���꣨x=�У�y=�У�
                        unsigned char *lightmap) // ����ͼ�����ڼ�����ͨ���ƽ�����ȣ�
{
  int searchIndex,i,length;
  int qx,qy;
  labelmap[pixelIndex]=labelIndex;//����ǰ���� pixelIndex ���Ϊ������ͨ�� labelIndex
  length=MT9V03X_W*MT9V03X_H;//����ά����ת��Ϊһά����������ݸ���
  
  //area++;  // �ۼӵ�ǰ��
  //Connected_x[labelIndex] += x;
  //Connected_y[labelIndex] += y;
  //Connected_light[labelIndex] += lightmap[pixelIndex];
    
  for(i=0;i<4;i++)//��ά���� (x,y) תһά������ʽ��index = y * width + x���������ص�һά������searchIndex = pixelIndex + ��y * width + ��x��ͨ�� NeighborDirection ����ƫ�ƣ�
  {
   searchIndex=pixelIndex+NeighborDirection[i][0]*MT9V03X_W+NeighborDirection[i][1];//��ά����ת��Ϊһά����

   if(searchIndex >= 0 && searchIndex <length && bitmap[searchIndex] == 1 && labelmap[searchIndex] == 0)//������޳�ͼ��Χ,��8������δ�����İ׵����
   {
     
     labelmap[searchIndex]=labelIndex;//��������������ģ���е��������
     area++;
     

     
     //qy=y;
     //qx=(int)((searchIndex-y)/(MT9V03X_W));
     qy = searchIndex / MT9V03X_W;  // ����������
     qx = searchIndex % MT9V03X_W;  // ����������
     
     /*if(qy>Connected_ymax[labelIndex])
          Connected_ymax[labelIndex]=qy;
     if(qy<Connected_ymin[labelIndex])
          Connected_ymin[labelIndex]=qy;
     if(qx>Connected_xmax[labelIndex])
          Connected_xmax[labelIndex]=qx;
     if(qx<Connected_xmin[labelIndex])
          Connected_xmin[labelIndex]=qx;
     */
     Connected_x[labelIndex]+=qx;
     Connected_y[labelIndex]+=qy;
     //if(Connected_x[labelIndex]>=32767)
       //Connected_x[labelIndex]=0;

     Connected_light[labelIndex]+=lightmap[searchIndex];

     //��ֹ���������������
     if(area>=65535)
     {
       area=65535;
       break;//break
     }
     PushQueue(queue,searchIndex);//����������δ���������İ׵���� ��������Ϊ������
   }
  }
}


/*****************************************************************************
*�������ƣ�void ConnectedComponentLabeling(unsigned char *bitmap, unsigned char * labelmap)
*����˵������ͨ�����,���ű���ж�
*       �����ڶ�ֵͼ����ʶ�𲢱�����ж�������ͨ����Ŀ�꣩��ͬʱ����ÿ���������������������ƽ������
*����˵����bitmap:�����ͼ��  labelmap:��Ǿ���
*�������أ������ܵ��������
*�޸�ʱ�䣺2022��4��3��
*��    ע����
*ʹ��˵����ֻ�����������鼴�ɣ�i��2��ʼ
          area_map[i]Ϊÿ��������������
          Connected_x[i],Connected_y[i],Ϊÿ���������������
          Connected_light[i]��Ϊÿ�����������ƽ��ֵ
******************************************************************************/
//��Ƶ���ͨ�����ʮһ������
uint16_t areamax=0;//���Χ��ͨ��Ŀ���ͨ�����
uint8_t labelmax=0,//���Χ��ͨ����
        labeldel[100]={0}, //����ͨ��С��3����ͨ������
        labelcount=0;  //�ܵ���ͨ�����

//bitmap:�����ͼ��  labelmap:��Ǿ���
void ConnectedComponentLabeling(unsigned char *bitmap, unsigned char * labelmap)
{
  uint8_t i,j,labelIndex=1,del=0,x=1;
  int index,popIndex;
  Queue *queue = NULL;
  queue = (Queue*)malloc(sizeof(Queue));
  queue->first = NULL;
  queue->last = NULL;
  memset(labelmap,0,MT9V03X_W*MT9V03X_H);//��ձ�Ǿ���,ÿ����0����Ҫ
  memset(labeldel,0,100);//���ͨ��С��3����ͨ������
  memset(area_map,0,100);
  //memset(Connected_x,0,100);
  //memset(Connected_y,0,100);
  memset(Connected_x, 0, sizeof(Connected_x));
  memset(Connected_y, 0, sizeof(Connected_y));
  memset(Connected_light,0,100);
  areamax=0;
  labelcount=0;
  labelmax=1;
  int flag_1;
  int last_labelIndex=0;

  for(i = 1; i <=MT9V03X_H-1 ; i++)
  {
    for(j = 1; j <=MT9V03X_W-1 ; j++)
    {
      index=i*(MT9V03X_W)+j;//�����ĵ� ��ά������һά����洢 �����ķ�ʽ
      if(bitmap[index]==1 && labelmap[index]==0)//�׵���δ�����
      {
        /*if(labelIndex>=8)
        {
        break;
        }*/
        labelIndex++;//�������
        SearchNeighbor_4(bitmap,labelmap,labelIndex,index,queue,i,j,(unsigned char *)mt9v03x_image);//������������� ������ģ���ϼ���������
        popIndex=PopQueue(queue);//ȷ����һ��������������
        while(popIndex>-1)// pop��ͬʱ ����������������Ƿ����µİ׵㲢�����һֱ�ظ�  һֱpopֱ��������û�н���ʱ�������Ϊ������
        {
         
          SearchNeighbor_4(bitmap,labelmap,labelIndex,popIndex,queue,i,j,(unsigned char *)mt9v03x_image);//�����а׵���������һ�����������
          popIndex = PopQueue(queue);//������������������Ϊ��һ�ε�������ʼλ��,֪��������������������,��������������
          
        }
      }
      flag_1=labelIndex - last_labelIndex;
      last_labelIndex = labelIndex;

      if(flag_1==1)
      {
          area_map[labelIndex]=area; //������ͨ������

          Connected_x[labelIndex]=(int)(Connected_x[labelIndex]/area);  //��ͨ������x
          Connected_y[labelIndex]=(int)(Connected_y[labelIndex]/area);  //��ͨ������y
          Connected_light[labelIndex]=(int)(Connected_light[labelIndex]/area);
          
          
          flag_1 = 0;
      }

      if(x!=labelIndex)//��ֹһ����ͨ����
      {
        x=labelIndex;//X�������м�����ͨ����
        if(area>areamax)//ȷ�����Χ����ͨ��
        {
          areamax=area;
          labelmax=labelIndex;
        }

        if(area<=1)//     �������ж�,���п���
        {
          labeldel[del]=labelIndex;
          del++;
          if(del>=9) del=9;
        }

        area=0;
      }
    }
  }
  free(queue);//һ��ͼ�������ͷŶ��пռ�

  //�����ܵ��������
  labelcount=labelIndex-1;

}

int quanzhi_weight[100];
void quanzhong_light_panduan(void)
{
    float zz_return;
    memset(quanzhi_weight,0,100);
    for(int i=2;i<=labelcount+2;i++)
    {
        zz_return = Square_detection(Connected_x[i],Connected_y[i]);
        if(zz_return<0.8)//��������
        {
          
            quanzhi_weight[i]=0;
            continue;
        }
        if(((Connected_x[i]<30&&(Connected_y[i]<30||Connected_y[i]>100)) || (Connected_x[i]>130&&(Connected_y[i]<30||Connected_y[i]>100)))&&area_map[i]>30)//Զ��̫��
        {
            quanzhi_weight[i]=0;
            continue;
        }
        if((Connected_x[i]>54&&Connected_x[i]<74&&Connected_y[i]>30&&Connected_y[i]<100 )&& area_map[i]<10)//����̫С
        {
            quanzhi_weight[i]=0;
            continue;
        }
        //Ȩ��ֵԽ�����ű�Ƶĸ���Խ��
        //120��1500Ϊ��ǰʹ�þ�ͷ�µĲ�������ͬ��ͷ��Ҫ�����޸�
        //120Ϊͼ�����¸߶ȣ�1500Ϊͼ��Ĭ������¿��ܳ��ֵ�������
        quanzhi_weight[i]= (int) (((1-(abs((int)Connected_x[i]-94)*1.0/94))+(1-(abs((int)Connected_y[i]-60)*1.0/60)))*10+(area_map[i]*1.0/10000)+Connected_light[i]+zz_return*10);
 
    }

}
int center_x ; 
int center_y ;
//Ѱ�����Ȩ��ֵ
int find_max(void)
{
    int wei=2;
    int maxx=quanzhi_weight[2];
    for(int i=3;i<=labelcount+2;i++)
    {
        if(quanzhi_weight[i]>maxx)
        {
            maxx = quanzhi_weight[i];
            wei=i;
        }
    }
     //����
          
          float screen_x = Connected_x[wei] * 128.0f / MT9V03X_W;
          float screen_y = Connected_y[wei] * 81.0f / MT9V03X_H;
          
          center_x =Connected_x[wei]; 
          center_y =Connected_y[wei];
          //xx = (int)screen_x;
          //yy = (int)screen_y;
          
           //ӳ�䵽Ŀ��ֱ��� (128��81)
          //float screen_x = center_x[wei] * (128.0f / MT9V03X_W);
          //float screen_y = center_y[wei] * (81.0f / MT9V03X_H);
          //float screen_x = center_x[wei] * (127.0f / (MT9V03X_W - 1));  // ӳ�䵽0-127
          //float screen_y = center_y[wei] * (81.0f / (MT9V03X_H - 1));   // ӳ�䵽0-81
          //xx = (int)screen_x;
          //yy = (int)screen_y;
           xx = (int)screen_x;  // ��������
           yy = (int)screen_y;
          
          //xx=(int)center_x[wei];
          //yy=(int)center_y[wei];
          
          if(xx>=127)xx=127;
          if(xx<=0)xx=0;
          if(yy>=81)yy=81;
          if(yy<=0)yy=0;
    return wei;
}

